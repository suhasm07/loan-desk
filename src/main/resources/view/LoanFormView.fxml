<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="600.0" prefWidth="450.0" spacing="8.0" stylesheets="@../css/loandesk.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label fx:id="loanDateLabel" prefWidth="300.0" styleClass="hint-label" text="Loan date" />
        <Label prefWidth="300.0" text="Item code (letters, digits and hyphens, up to 20)" />
        <TextField fx:id="itemCode" maxWidth="300.0" />
        <Label prefWidth="300.0" text="Item name" />
        <TextField fx:id="itemName" maxWidth="300.0" />
        <Label prefWidth="300.0" text="Borrower name" />
        <TextField fx:id="borrowerName" maxWidth="300.0" />
        <Label prefWidth="300.0" text="Category" />
        <ComboBox fx:id="categoryBox" prefWidth="300.0" promptText="Select a category" />
        <Label prefWidth="300.0" text="Due date" />
        <DatePicker fx:id="dueDatePicker" editable="false" prefWidth="300.0" promptText="Select a due date" />
        <Label prefWidth="300.0" text="Note (optional, up to 250 characters)" />
        <TextArea fx:id="noteArea" maxWidth="300.0" prefHeight="90.0" wrapText="true" />
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button fx:id="saveButton" defaultButton="true" mnemonicParsing="false" text="Save loan" />
                <Button fx:id="cancelButton" mnemonicParsing="false" styleClass="secondary" text="Cancel" />
            </children>
            <VBox.margin>
                <Insets top="10.0" />
            </VBox.margin>
        </HBox>
        <Label fx:id="status" maxWidth="400.0" wrapText="true" />
    </children>
</VBox>