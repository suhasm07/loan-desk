<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="500.0" prefWidth="950.0" spacing="10.0" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label text="My loans" />
        <TableView fx:id="loanTable" prefHeight="400.0" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                <TableColumn fx:id="codeColumn" prefWidth="90.0" text="Item code" />
                <TableColumn fx:id="nameColumn" prefWidth="130.0" text="Item name" />
                <TableColumn fx:id="borrowerColumn" prefWidth="110.0" text="Borrower" />
                <TableColumn fx:id="categoryColumn" prefWidth="90.0" text="Category" />
                <TableColumn fx:id="loanDateColumn" prefWidth="90.0" text="Loan date" />
                <TableColumn fx:id="dueDateColumn" prefWidth="90.0" text="Due date" />
                <TableColumn fx:id="returnDateColumn" prefWidth="90.0" text="Return date" />
                <TableColumn fx:id="statusColumn" prefWidth="80.0" text="Status" />
                <TableColumn fx:id="noteColumn" prefWidth="130.0" text="Note" />
            </columns>
        </TableView>
        <HBox alignment="CENTER_LEFT" spacing="15.0">
            <children>
                <Button fx:id="addButton" mnemonicParsing="false" text="Add loan" />
                <Button fx:id="refreshButton" mnemonicParsing="false" text="Refresh" />
                <Button fx:id="closeButton" mnemonicParsing="false" text="Close" />
                <Label fx:id="status" />
            </children>
        </HBox>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>