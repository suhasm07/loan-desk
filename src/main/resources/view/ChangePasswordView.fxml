<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="380.0" prefWidth="420.0" spacing="8.0" stylesheets="@../css/loandesk.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <Label prefWidth="260.0" text="Current password" />
        <PasswordField fx:id="currentPassword" maxWidth="260.0" />
        <Label prefWidth="260.0" text="New password" />
        <PasswordField fx:id="newPassword" maxWidth="260.0" />
        <Label prefWidth="260.0" text="Type the new password again" />
        <PasswordField fx:id="confirmPassword" maxWidth="260.0" />
        <Label maxWidth="260.0" styleClass="hint-label" text="At least 8 characters with an uppercase letter, a lowercase letter, a digit and one of ! @ # $ % ^ &amp; * ? . _ -" wrapText="true" />
        <HBox alignment="CENTER" prefHeight="40.0" spacing="20.0">
            <children>
                <Button fx:id="saveButton" mnemonicParsing="false" text="Save password" />
                <Button fx:id="closeButton" mnemonicParsing="false" styleClass="secondary" text="Close" />
            </children>
        </HBox>
        <Label fx:id="status" maxWidth="360.0" wrapText="true" />
    </children>
</VBox>