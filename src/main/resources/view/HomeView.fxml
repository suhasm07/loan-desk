<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.VBox?>
<VBox alignment="CENTER" prefHeight="350.0" prefWidth="500.0" spacing="15.0" xmlns="http://javafx.com/javafx/18" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="welcomeLabel" text="Welcome">
      <font>
        <Font size="20.0" />
      </font>
      <VBox.margin>
        <Insets bottom="10.0" />
      </VBox.margin>
    </Label>
    <Button fx:id="loansButton" mnemonicParsing="false" prefWidth="180.0" text="Manage loans" />
    <Button fx:id="exportButton" mnemonicParsing="false" prefWidth="180.0" text="Export all loans" />
    <Button fx:id="profileButton" mnemonicParsing="false" prefWidth="180.0" text="Edit profile" />
    <Button fx:id="logoutButton" mnemonicParsing="false" prefWidth="180.0" text="Logout" />
    <Label fx:id="status" />
  </children>
</VBox>
