<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="350.0" prefWidth="500.0" spacing="12.0" stylesheets="@../css/loandesk.css" xmlns="http://javafx.com/javafx/8" xmlns:fx="http://javafx.com/fxml/1">
  <children>
    <Label fx:id="welcomeLabel" maxWidth="450.0" styleClass="title-label" text="Welcome" textAlignment="CENTER" wrapText="true" />
    <Label styleClass="hint-label" text="What would you like to do?" />
    <Button fx:id="loansButton" mnemonicParsing="false" prefWidth="200.0" text="Manage loans" />
    <Button fx:id="exportButton" mnemonicParsing="false" prefWidth="200.0" text="Export all loans" />
    <Button fx:id="profileButton" mnemonicParsing="false" prefWidth="200.0" text="Edit profile" />
    <Button fx:id="logoutButton" mnemonicParsing="false" prefWidth="200.0" styleClass="secondary" text="Log out" />
    <Label fx:id="status" maxWidth="450.0" wrapText="true" />
  </children>
</VBox>